\":{\"accommodation\":4.4,\"overall\":4,\"itinerary\":3.8,\"transport\":4.2,\"food\":4.1,\"guide\":4.5,\"operator\":4.5},\"reviews_count\":12,\"age_range\":{\"strict\":{\"min_age\":5,\"max_age\":99},\"recommended\":null},\"services\":{\"guide\":[{\"description\":\"<p>An expert Travel Director and separate Driver<\\/p>\",\"is_included\":true}],\"meals\":[{\"description\":\"<ul><li>8 Breakfast (B)<\\/li><li>3 Lunch (L)<\\/li><li>3 Dinner (D)<\\/li><\\/ul>\",\"is_included\":true,\"food_options\":[\"jain\",\"vegetarian\",\"vegan\",\"halal\",\"kosher\",\"meat\"]}],\"others\":[{\"description\":\"<ul><li>Kyoto: Meet Nakamura Family for a kaiseki lunch at a traditional Japanese Restaurant near Kyoto and learn about local customs.<\\/li><li>Ginza: With the guidance of your professional sushi chef, make your own selection of sushi specialities. Afterwards enjoy the fruits of your labour with a delicious lunch.<\\/li><li>Takayama: Sample Japanese sake during a walking tour in the Edo-style streets of Takayama Old Town.<\\/li><li>Tokyo: Visit Tokyo's renowned landmarks and gain insight into how this modern city preserves its ancient roots.<\\/li><li>Tokyo: Visit the Tokyo National Museum to browse collections of Japanese art and archaeological objects.<\\/li><li>Mt Fuji: Start your day by visiting the small rural village of Oshino Hakkai which is home to eight natural spring water ponds. Next on your travels is a 2,300-meter winding road to Mt. Fuji 5th Station. To end your day, you will ride up to Mt. Tenjo by ropeway and bask in the breath-taking views.<\\/li><li>Gokayama: Take some time to admire the peaceful mountain village of Gokayama. Discover their unique homes that have been built without the use of nails and their sloped thatched roofs.<\\/li><li>Kanazawa: Learn about the delicacy of the 16th-century craft gold leaf painting with your Local Specialist.<\\/li><li>Kanazawa: Enjoy a stroll through Omicho market before making your way to the beautiful Gardens of Kenrokuen which have been shaped over the past one hundred years.<\\/li><li>Kyoto: Admire the beautiful golden pavilion of Kinkakuji Temple.<\\/li><li>Kyoto: Your city tour takes you to the orange gates of the Fushimi Inari Shrine. Admire this sacred site before visiting Sanjeusangen-do-Hall, where you can view the 1,001 \\\"thousand-handed\\\" goddesses of mercy statues. Continue your exploration of Kyoto with a walking tour through the Gion district.<\\/li><li>Gokayama: Help support a local business with a visit to a washi paper workshop. You'll watch the family at work and test your paper-making skills for yourself. Your experience directly supports United Nations Sustainable Development Goal 11: Sustainable Cities and Communities.<\\/li><li>Explore Tokyo and Kyoto<\\/li><li>Visit the Sensoji Temple, the Skytree Observation Tower, the Edo Tokyo Museum in Tokyo, Mt. Fuji 5th Station, the Kinkakuji Temple and Fushimi Inari Shrine and Sanjusangen-do Hall in Kyoto<\\/li><li>See the traditional Gassho-zukuri houses in Gokayama and the beautiful gardens of Kenrokuen in Kanazawa<\\/li><li>View Mt. Fuji<\\/li><li>An expert Travel Director and professional Driver<\\/li><li>Cherry-picked hotels, all tried and trusted<\\/li><li>All porterage and restaurant gratuities<\\/li><li>All hotel tips, charges and local taxes<\\/li><li>Breakfast daily and up to half of your evening meals<\\/li><li>Must-see sightseeing and surprise extras<\\/li><li>Audio headsets for flexible sightseeing<\\/li><li>Optional Experiences and free time<\\/li><li>On occasion, hotels of similar standard and location may be utilised.<\\/li><\\/ul>\",\"is_included\":true},{\"description\":\"<p>Other activities and services are not included.\\u00a0<\\/p>\",\"is_included\":false}],\"flights\":[{\"description\":\"<p>Flights are not included.<\\/p>\",\"is_included\":false}],\"optional\":[{\"description\":\"<p>Other activities and services are not included.\\u00a0<\\/p>\",\"is_included\":false}],\"insurance\":[{\"description\":\"<p>Insurance is not included.<\\/p>\",\"is_included\":false}],\"transport\":[{\"description\":\"<ul><li>Luxury air-conditioned coach with Wi-Fi in most countries or alternative transportation (such as rail journeys)<\\/li><\\/ul>\",\"is_included\":true,\"ships\":[]}],\"accommodation\":[{\"description\":\"<ul><li>New Otani Garden Tower<\\/li><li>Fuji Marriott Yamanakako<\\/li><li>Associa Takayama Resort<\\/li><li>Kanazawa Tokyu<\\/li><li>The Hotel Higashiyama<\\/li><\\/ul>\",\"is_included\":true,\"accommodations\":[{\"type\":\"hotel\",\"nights\":null}],\"ship_rooms\":[]}],\"hygieneprotocol\":[]},\"is_instant_confirmable\":true,\"guide_languages\":[1],\"start_point\":[],\"end_point\":[],\"departure_months\":[{\"year\":2025,\"month\":10},{\"year\":2025,\"month\":11},{\"year\":2025,\"month\":12},{\"year\":2025,\"month\":3},{\"year\":2025,\"month\":4},{\"year\":2025,\"month\":5},{\"year\":2025,\"month\":6},{\"year\":2025,\"month\":7},{\"year\":2025,\"month\":8},{\"year\":2025,\"month\":9},{\"year\":2026,\"month\":3},{\"year\":2026,\"month\":4}],\"codes\":[\"177|itinerary:base|length:9|theme:none\",\"JPNLM20\",\"JPNLN20\",\"JPNLZM18\",\"JPNLZM19\",\"JPNLZN18\",\"JPNLZN19\"],\"itinerary\":[{\"description\":\"Your in-depth exploration of Japan begins in Tokyo. On arrival at Narita or Haneda Airport, take a shuttle bus transfer to your centrally located hotel, where you\\u2019ll join your Travel Director and fellow guests for a welcome drink and local appetisers.\",\"duration\":1,\"order\":1,\"title\":\"Day 1: Konnichiwa Tokyo\",\"locations\":[]},{\"description\":\"We launch our city tour in the old-time entertainment centre of Asakusa, where we\\u2019ll encounter the Sensoji Buddhist Temple. One of Tokyo's most colourful and popular temples, Sensoji has been rebuilt countless times since it was founded in 628, making it Tokyo's oldest temple site. Strolling down Nakamise next, immerse yourself in the sights and sounds of shitamachi (downtown Tokyo), admiring the wooden dolls, colourful chiyogami (origami paper) and traditional Japanese sweets. Ascend Tokyo Skytree, the world's highest free-standing broadcasting tower for panoramic views of the city.\",\"duration\":1,\"order\":2,\"title\":\"Day 2: Explore Vibrant Tokyo\",\"locations\":[]},{\"description\":\"Our first stop today is the Imperial Palace Plaza from where the two bridges that form the entrance to the inner grounds of the Imperial Palace can be viewed. We'll have the opportunity to explore the leafy Imperial Palace East Gardens before continuing our city tour. At the Tokyo National Museum browse collections of Japanese art, then continue to the Ginza district where you\\u2019ll learn how to make sushi with a professional sushi chef. Venture to the Five Lakes District next, keeping a keen eye out for the UNESCO-listed Mt. Fuji which dominates the landscape.\",\"duration\":1,\"order\":3,\"title\":\"Day 3: Off to the Five Lakes District\",\"locations\":[{\"latitude\":35.011651,\"city_name\":\"Kyoto\",\"longitude\":135.768592,\"location_id\":4469,\"country_code\":\"JP\"}]},{\"description\":\"Visit Oshino Hakkai, a small rural village in the Fuji Five Lakes district, renowned for eight natural spring water ponds that are fed by melted snow from Mt. Fuji. Admire the reflections of the sky and landscapes in its clear waters, then ascend Mt. Fuji by road to 2,300 metres at the 5th station. Ride up Mt. Tenjo on the Kachikachiyama Ropeway next, for jaw-dropping views (weather permitting) of Mt. Fuji and Lake Kawaguchiko. Then, journey through the Japanese Alps to the beautiful hillside town of Takayama, before enjoying dinner at the hotel.\",\"duration\":1,\"order\":4,\"title\":\"Day 4: Majestic Mt. Fuji and Timeless Takayama\",\"locations\":[{\"latitude\":36.146158,\"city_name\":\"Takayama\",\"longitude\":137.252144,\"location_id\":13849,\"country_code\":\"JP\"}]},{\"description\":\"Immerse yourself in tradition as you walk through the Edo-style streets of Takayama's Old Town. Indulge a lunch of Japanese Hida-gyu \\u2013 beef from a black-haired Japanese cattle breed, renowned as one of the finest quality varieties of beef. Journey back in time this afternoon during a visit to the peaceful UNESCO-listed Gokayama, a mountain village set amidst five valleys. Admire the unique construction of the local Gassho-zukuri wooden houses that have been built without the use of nails with steeply sloped thatched roofs to prevent snow from building up on them. Meet with a local family in one of these houses. Observe local artisans making washi paper and try your hand at making your own. Make a difference to the sustainability of this small business during MAKE TRAVEL MATTER\\u00ae Experience. Stay overnight in Kanazawa.\",\"duration\":1,\"order\":5,\"title\":\"Day 5: Experience Gokayama and on to Kanazawa Dive Into Culture Make Travel Matter\",\"locations\":[{\"latitude\":36.146158,\"city_name\":\"Takayama\",\"longitude\":137.252144,\"location_id\":13849,\"country_code\":\"JP\"},{\"latitude\":36.561045,\"city_name\":\"Kanazawa\",\"longitude\":136.656575,\"location_id\":4462,\"country_code\":\"JP\"}]},{\"description\":\"Join a Local Specialist\\u00a0this morning to learn the secrets of painting gold leaf, a delicate craft the Japanese have been perfecting since the 16th century. Continue to the tranquil gardens of Kenroku-en, which took shape over a hundred years to emerge as one of Japan\\u2019s most beautiful gardens. Connecting with your exquisite natural surrounds, you\\u2019ll stroll through ornate landscapes and past ponds and temples. Take a short walk through the Omicho market next to see the local fish catch and enjoy an insider\\u2019s view of everyday life in a busy coastal town. Then, visit the Nagamachi District with its beautifully preserved samurai houses that line the traditional stone streets. Here you will gain first-hand insights into samurai life during a visit to the Nomura house, an elegant samurai mansion.\",\"duration\":1,\"order\":6,\"title\":\"Day 6: Traditional Kanazawa\",\"locations\":[]},{\"description\":\"Board an Express train this morning to Kyoto, where you'll connect with locals at a traditional restaurant on your Be My Guest experience. You'll learn about local Japanese customs from your hosts. After lunch, visit the UNESCO-listed Kinkakuji Temple with its famous Kinkaku (Golden Pavilion), the proud symbol of Kyoto and a Zen temple, which has its origins as a 14th-century villa.\",\"duration\":1,\"order\":7,\"title\":\"Day 7: Onwards to Kyoto Connect with Locals\",\"locations\":[{\"latitude\":36.561045,\"city_name\":\"Kanazawa\",\"longitude\":136.656575,\"location_id\":4462,\"country_code\":\"JP\"},{\"latitude\":35.011651,\"city_name\":\"Kyoto\",\"longitude\":135.768592,\"location_id\":4469,\"country_code\":\"JP\"}]},{\"description\":\"The blazing orange torii gates of Fushimi Inari Shrine guide your path through the forest, up into the mountains and to a sacred site that has heard prayers for prosperity and happiness since the 8th century. Continue to Sanjusangen-do Hall and admire the minute detail of each of its 1,001 \\u201cthousand-handed\\u201d goddesses of mercy statues, then enjoy a walking tour of the Gion area. This evening, indulge in dinner with your Travel Director and fellow guests.\",\"duration\":1,\"order\":8,\"title\":\"Day 8: Discover Enchanting Kyoto\",\"locations\":[{\"latitude\":35.011651,\"city_name\":\"Kyoto\",\"longitude\":135.768592,\"location_id\":4469,\"country_code\":\"JP\"}]},{\"description\":\"Our encounter with Japan\\u2019s age-old traditions and modern cityscapes at its end, we take a transfer by airport shuttle service to Kansai International Airport or Osaka Itami Airport for our onward flight. Alternatively, continue to Hiroshima by choosing the 13-day Splendours of Japan with Hiroshima itinerary.\",\"duration\":1,\"order\":9,\"title\":\"Day 9: Sayonara Japan\",\"locations\":[{\"latitude\":36.561045,\"city_name\":\"Kanazawa\",\"longitude\":136.656575,\"location_id\":4462,\"country_code\":\"JP\"}]}],\"has_machine_translated_content\":false},\"duration\":484,\"hostname\":\"3b7cd82e3913\"}, 2025-02-25 05:19:22, ?, client_request, 9e4b428c-e657-4d5b-b163-8156ee01cd28), (9e4b4293-ae18-44f7-a5f7-715fb045944c, {\"method\":\"POST\",\"uri\":\"https:\\/\\/oauth.api.sandbox.b2b.tourradar.com\\/oauth2\\/token\",\"headers\":{\"content-length\":\"200\",\"user-agent\":\"GuzzleHttp\\/7\",\"host\":\"oauth.api.sandbox.b2b.tourradar.com\",\"content-type\":\"application\\/x-www-form-urlencoded\",\"authorization\":\"********\"},\"payload\":{\"grant_type\":\"client_credentials\",\"scope\":[\"com.tourradar.tours\\/read\",\"com.tourradar.operators\\/read\",\"com.tourradar.bookings\\/read\",\"com.tourradar.bookings\\/write\"]},\"response_status\":200,\"response_headers\":{\"content-type\":\"application\\/json\",\"content-length\":\"2283\",\"connection\":\"keep-alive\",\"date\":\"Tue, 25 Feb 2025 05:19:22 GMT\",\"x-amzn-trace-id\":\"Root=1-67bd52da-1a5e841278fd4dd87931264a\",\"x-amzn-requestid\":\"3f2ce11d-c3c3-4800-b0fd-ff8505567da0\",\"access-control-allow-origin\":\"*\",\"x-amz-apigw-id\":\"GhniQFSEIAMEHoA=\",\"x-cache\":\"Miss from cloudfront\",\"via\":\"1.1 b5afed9af6ab9ac8245e8872d677a7bc.cloudfront.net (CloudFront)\",\"x-amz-cf-pop\":\"LAX53-P4\",\"x-amz-cf-id\":\"VE7l0IOe4tEcM7skDsg3myzIqjgovkL53D9HhPnZ3l6K9glrrRyZEA==\"},\"response\":{\"access_token\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..d_ZvBWUKECD155hQuDNM7_E6wBdZf9SdkHu2yBJRg0YPd7tPJYSoBI7TZGklnGCHGhCxbrXXfTf_bxYcDVodXTkRDkqb7qK830PF9HVh9CPmiLA2K19h0kJZAh4kZJP3_i6qhd0Y1isxc189kF0FIUF9Gtbg6ncEVY1KJw5w7-5RdPUl0v3WOVajh_nl-W4FKC92ehFLUXBR5PXsClsx8no4AZ8R0bwBlsc5iKAUOlnkFn-mX6n2Acok99QHKAL4MpAj4vxsb9L8sFBZcReGocrwx3_CazP76WfJy-3Zfo5qHtXq6rYUEx5Yu8HU2u6QIsSekeyFhb4e07WqjNTnoVCYt9ExFeh1GEyGLYfHZyYaEJkcYbQSVmfEeQn6JR7HdQwX-09dWrCf0RuieDdAzOu-niMy16_WjunHJMTPCxWAnesTLv-eDzkzrs-ldEyKksTAb4LZh91QF1mXOJAEkLH8jhz3IhHLJzCK9MZMHWdLqE8uHOa-Wf2AL0Eps5Jdv_1xalldnF3CYnw8RIVO3GoErR2