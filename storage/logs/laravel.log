  \"<span class=sf-dump-key>prices</span>\" => <span class=sf-dump-note>array:3</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>based_on</span>\" => \"<span class=sf-dump-str title=\"22 characters\">Standard accommodation</span>\"
    \"<span class=sf-dump-key>price_total</span>\" => <span class=sf-dump-num>3730</span>
