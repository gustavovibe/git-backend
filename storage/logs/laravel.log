se_headers\":{\"cache-control\":\"no-cache, private\",\"date\":\"Thu, 16 Oct 2025 04:12:22 GMT\",\"content-type\":\"application\\/json\",\"x-ratelimit-limit\":\"60\",\"x-ratelimit-remaining\":\"58\",\"access-control-allow-origin\":\"*\",\"access-control-allow-methods\":\"GET, POST, PUT, DELETE, OPTIONS\",\"access-control-allow-headers\":\"Content-Type, Authorization\"},\"response_status\":200,\"response\":{\"success\":true,\"data\":[{\"id\":60,\"user_id\":67,\"wish_id\":0,\"tour_id\":92945,\"notes\":\"new tour wishlist\",\"tour_data\":{\"tour_id\":92945,\"tour_name\":\"Essential Botswana (from Johannesburg to Victoria Falls)\",\"overview\":\"Time to break out your best Attenborough impression \\u2013 you\\u2019re going on safari with a small group of legends! This nine-day trip doesn\\u2019t skimp on the savanna, but it mainly follows the rivers and watering holes that sustain life (human and wild) throughout Africa. Learn about the world\\u2019s largest succulents on a guided walk along baobabs and see elephants and warthogs while you cruise down the Okavango Delta in a dugout mokoro canoe. How many species can you spot on a search for wildlife in Chobe National Park? <br \\/><br \\/>This is an overland trip. That means you\\u2019ll be travelling with a group in a purpose-built vehicle, visiting remote communities, setting up your own tent, occasionally roughing it in the bush with no facilities, and getting the best possible views of Africa's iconic wildlife. While the trucks don\\u2019t have air conditioning, they do have sliding windows, which let in the breeze and make it even easier to take spectacular snaps of the local wildlife. The drive days can be long, but it\\u2019s as much about the journey as the destination, and half the fun is the camaraderie. For more info on this style of travel, see our Africa overland page: https:\\/\\/www.intrepidtravel.com\\/africa\\/overland, As this trip only has limited time in Victoria Falls, we highly recommend staying a few extra days after your tour to enjoy all this amazing destination has to offer., The African wild comes alive at sunrise, so there will be some early starts for game drives. The thrill of spotting your first lion or rhino is well worth the early start!, This trip is a great way to see a lot in a short period of time and it can be part of a longer itinerary if you have more time to explore. You might like to check out Real Southern Africa.\",\"ratings\":4.4,\"reviews_count\":13,\"tour_length_days\":9,\"max_group_size\":22,\"images\":[\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_6240cb4d.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_4b343592.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_2060af15.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_087bdcdb.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_889fd213.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_5c73e1cf.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_3bae7bbf.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_d9dc0acd.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_0115c9cb.jpg\",\"https:\\/\\/cdn.tourradar.com\\/s3\\/tour\\/1500x800\\/92945_ccb154bd.jpg\"],\"map\":\"https:\\/\\/cdn.tourradar.com\\/s3\\/map\\/1500x800\\/92945_cd88.png\",\"guiding_method\":{\"type_id\":373,\"type_name\":\"Fully Guided\",\"group_id\":2,\"group_name\":\"Guide Type\"},\"tour_type\":{\"4\":{\"type_id\":372,\"type_name\":\"Group\",\"group_id\":1,\"group_name\":\"Group Type\"}},\"tour_types\":[{\"type_id\":4,\"type_name\":\"Overland Truck\",\"group_id\":11,\"group_name\":\"Adventure Styles\"},{\"type_id\":24,\"type_name\":\"Wildlife\",\"group_id\":21,\"group_name\":\"Safari Styles\"},{\"type_id\":173,\"type_name\":\"Camping\",\"group_id\":12,\"group_name\":\"Adventure Activities\"},{\"type_id\":354,\"type_name\":\"Elephant\",\"group_id\":21,\"group_name\":\"Safari Styles\"},{\"type_id\":372,\"type_name\":\"Group\",\"group_id\":1,\"group_name\":\"Group Type\"},{\"type_id\":373,\"type_name\":\"Fully Guided\",\"group_id\":2,\"group_name\":\"Guide Type\"},{\"type_id\":377,\"type_name\":\"Easy\",\"group_id\":3,\"group_name\":\"Physical rating type\"},{\"type_id\":403,\"type_name\":\"Private Room\",\"group_id\":29,\"group_name\":\"Solo Travelers\"},{\"type_id\":404,\"type_name\":\"Shared Room\",\"group_id\":29,\"group_name\":\"Solo Travelers\"}],\"age_range_formatted\":\"18-35\",\"age_range\":{\"strict\":{\"min_age\":18,\"max_age\":35},\"recommended\":{\"min_age\":18,\"max_age\":29}},\"guide_languages\":[{\"id\":1,\"code\":\"en\",\"name\":\"English\"}],\"start_city\":{\"latitude\":-26.203334,\"city_name\":\"Johannesburg\",\"longitude\":28.043102,\"location_id\":9137,\"country_code\":\"ZA\"},\"end_city\":{\"latitude\":-17.931524,\"city_name\":\"Victoria Falls\",\"longitude\":25.827297,\"location_id\":9047,\"country_code\":\"ZW\"},\"destinations\":{\"cities\":[{\"latitude\":-26.203334,\"city_name\":\"Johannesburg\",\"longitude\":28.043102,\"location_id\":9137,\"country_code\":\"ZA\"},{\"latitude\":-22.231925,\"city_name\":\"Khama Rhino Sanctuary\",\"longitude\":26.690705,\"location_id\":9572,\"country_code\":\"BW\"},{\"latitude\":-19.993998,\"city_name\":\"Maun\",\"longitude\":23.411865,\"location_id\":9563,\"country_code\":\"BW\"},{\"latitude\":-19.335906,\"city_name\":\"Okavango Delta\",\"longitude\":22.930074,\"location_id\":11629,\"country_code\":\"BW\"},{\"latitude\":-17.7,\"city_name\":\"Kwando\",\"longitude\":23.48333,\"location_id\":42346,\"country_code\":\"NA\"},{\"latitude\":-18.730573,\"city_name\":\"Chobe National Park\",\"longitude\":24.429232,\"location_id\":9576,\"country_code\":\"BW\"},{\"latitude\":-17.931524,\"city_name\":\"Victoria Falls\",\"longitude\":25.827297,\"location_id\":9047,\"country_code\":\"ZW\"}],\"countries\":[{\"location_id\":161,\"country_code\":\"ZA\",\"country_name\":\"South Africa\",\"currency_code\":\"ZAR\",\"currency_name\":\"Rand\",\"electricity_outlets\":[]},{\"location_id\":24,\"country_code\":\"BW\",\"country_name\":\"Botswana\",\"currency_code\":\"BWP\",\"currency_name\":\"Pula\",\"electricity_outlets\":[\"D\",\"M\"]},{\"location_id\":122,\"country_code\":\"NA\",\"country_name\":\"Namibia\",\"currency_code\":\"NAD\",\"currency_name\":\"Namibia Dollar\",\"electricity_outlets\":[]},{\"location_id\":194,\"country_code\":\"ZW\",\"country_name\":\"Zimbabwe\",\"electricity_outlets\":[\"G\"]}],\"natural_destinations\":[{\"location_id\":1001127,\"country_code\":\"BW\",\"natural_destination_name\":\"Okavango\",\"type\":\"region\",\"latitude\":-19.565763767419952,\"longitude\":22.872598891800994},{\"location_id\":1001355,\"country_code\":\"ZW\",\"natural_destination_name\":\"Victoria Falls\",\"type\":\"national-park\",\"latitude\":-17.944807378726427,\"longitude\":25.85144203051065},{\"location_id\":1001358,\"country_code\":\"BW\",\"natural_destination_name\":\"Chobe National Park\",\"type\":\"national-park\",\"latitude\":-18.547872127079643,\"longitude\":24.526399933502212}]},\"prices\":{\"based_on\":\"Twin Room\",\"price_total\":1315,\"mandatory_addons\":[]},\"itinerary\":[{\"description\":\"<p>Sawubona! Welcome to South Africa. Touch down in Jo\\u2019burg (as the locals like to call it) where your adventure begins, ready for your welcome meeting at 6 pm tonight. If you arrive early, maybe visit the Apartheid Museum to start your journey with some local history, crucial in understanding this region. After your meeting, why not head out for a group dinner and get to know your fellow travellers. Your leader can point you in the right direction if you\\u2019re looking for local bars and restaurant recommendations.<\\/p>\",\"duration\":1,\"order\":1,\"title\":\"Day 1: Johannesburg\",\"locations\":[{\"latitude\":-26.203334,\"city_name\":\"Johannesburg\",\"longitude\":28.043102,\"location_id\":9137,\"country_code\":\"ZA\"}]},{\"description\":\"<p>See ya South Africa \\u2013 this morning, you\\u2019ll cross the border into Botswana and travel to the Khama Rhino Sanctuary. It sits on the Kalahari Desert and is an old hunting area transformed into a conservation project. It now protects what\\u2019s left of Botswana's black and white rhino populations, but you can also see zebras, giraffes, leopards, ostriches and wildebeest, all of which chill out around the natural waterholes. Not only do you get to check out the animals here, but you\\u2019ll also be benefitting local communities and helping protect the white rhino. When the sun begins to set, hop in a jeep to see the rhinos at their most active. About 35 rhinos roam around this 400-hectare community-based reserve, so don\\u2019t forget your binoculars!<\\/p>\",\"duration\":1,\"order\":2,\"title\":\"Day 2: Khama Rhino Sanctuary\",\"locations\":[{\"latitude\":-22.231925,\"city_name\":\"Khama Rhino Sanctuary\",\"longitude\":26.690705,\"location_id\":9572,\"country_code\":\"BW\"}]},{\"description\":\"<p>Get up nice and early and drive to Maun. When you arrive, you\\u2019ll have the chance to stock up on any supplies you might need for the journey ahead. This town is the gateway to one of the world's most renowned and complex ecosystems \\u2013 the Okavango Delta, a 16,000 square km maze of wetlands made up of waterways, green islands, lush plains and loads of wildlife. You might see hippos, crocodiles, elephants and big cats within the diverse ecosystem here. Tonight, you'll stay on the outskirts of Maun at a simple campsite with shared facilities, wi-fi and optional upgrades.<\\/p>\",\"duration\":1,\"order\":3,\"title\":\"Day 3: Maun\",\"locations\":[{\"latitude\":-19.335906,\"city_name\":\"Okavango Delta\",\"longitude\":22.930074,\"location_id\":11629,\"country_code\":\"BW\"},{\"latitude\":-19.993998,\"city_name\":\"Maun\",\"longitude\":23.411865,\"location_id\":9563,\"country_code\":\"BW\"}]},{\"description\":\"<p>Make your way to the north-western part of the Okavango Delta, close to the Pan Handle. Leave the truck and take a 4WD for the last 12 km to your campsite in the bush. Your accommodation for the next two nights sits on the edge of the Guma Lagoon area and might just be one of the trip\\u2019s highlights! When you arrive, set up camp, take in the incredible views of the Delta and relax on the edge of the water for the rest of the afternoon. Tonight, watch as the sunset turns into a brilliant sky full of stars, far away from any light pollution. Then, fall asleep to the sounds of the hippos in the distance.<\\/p>\",\"duration\":1,\"order\":4,\"title\":\"Day 4: Okavango Delta Pan Handle\",\"locations\":[{\"latitude\":-19.335906,\"city_name\":\"Okavango Delta\",\"longitude\":22.930074,\"location_id\":11629,\"country_code\":\"BW\"}]},{\"description\":\"<p>Today, you get to paddle the mighty Delta. There's nothing more relaxing than feeling the African sun on your face as you lie back in a mokoro (traditional dugout canoe), while your expert poler propels you down calm waters through papyrus and reed beds to lily-covered lagoons. Watch out for elephants, lechwe, warthogs and sitatunga on a quick bush walk, then stop at one of the islands for a swim before returning to camp. If you are interested in the culinary side of Southern Africa, feel free to join your cook for a cooking class while they prepare tonight's meal.<\\/p>\",\"duration\":1,\"order\":5,\"title\":\"Day 5: Okavango Delta Pan Handle\",\"locations\":[{\"latitude\":-19.335906,\"city_name\":\"Okavango Delta\",\"longitude\":22.930074,\"location_id\":11629,\"country_code\":\"BW\"}]},{\"description\":\"<p>Wake up to the sounds of the Delta this morning then travel back to Maun to relax. If you didn\\u2019t get the chance to take a helicopter flight on day three, you will have the opportunity to do so today. Otherwise, sit back, relax and get ready for the rest of your adventure.<\\/p>\",\"duration\":1,\"order\":6,\"title\":\"Day 6: Maun\",\"locations\":[{\"latitude\":-17.7,\"city_name\":\"Kwando\",\"longitude\":23.48333,\"location_id\":42346,\"country_code\":\"NA\"}]},{\"description\":\"<p>Drive to Gweta this morning \\u2013 a small town sitting near the stunning Makgadikgadi Salt Pans, which are some of the largest on Earth and covering around 12,000 square kilometres (4640 square miles). Drive through the national park before you arrive in Gweta. Tonight, you\\u2019ll head out on a Sundowner Bush Walk to explore the surrounding baobab forest with a local guide. Take in the unique scenery while your guide explains the local ecology, geology and biology of the largest succulent in the world. Watch the Botswana sunset with a drink by the campfire as you learn more about this vast saltpan desert that was once the largest expanse of fresh water on the planet.<\\/p>\",\"duration\":1,\"order\":7,\"title\":\"Day 7: Gweta\",\"locations\":[{\"latitude\":-18.730573,\"city_name\":\"Chobe National Park\",\"longitude\":24.429232,\"location_id\":9576,\"country_code\":\"BW\"}]},{\"description\":\"<p>Wake up early to drive to Chobe National Park today. You\\u2019ll have free time tonight to either rest or jump into some optional activities, like a sunset game drive or river cruise. There's a huge range of wildlife here, all packed into one tiny area, making it unlike anywhere else in the world! Huge herds of buffalo and elephants are often seen roaming around the savannah, matched by the size of the local lion prides. An estimated 70,000 Kalahari elephants roam the park, too \\u2013 these amazing beasts are the largest known subspecies of elephant in the world. You might also see zebras, impalas, wildebeest, giraffes, lions, leopards, hyenas, jackals, warthogs, baboons, monkeys and heaps of birds.<\\/p>\",\"duration\":1,\"order\":8,\"title\":\"Day 8: Chobe National Park\",\"locations\":[{\"latitude\":-18.730573,\"city_name\":\"Chobe National Park\",\"longitude\":24.429232,\"location_id\":9576,\"country_code\":\"BW\"}]},{\"description\":\"<p>Head out on a game drive in Chobe National Park this morning. Then, it\\u2019s on to the town of Victoria Falls this afternoon. Cross the border into Zimbabwe and arrive in the early afternoon. Before your trip officially ends, your leader will provide a quick orientation walk through town. There is so much to discover in Victoria Falls that it's highly recommended you stay a few extra days. If you'd like to extend your stay, just speak to your booking agent.<\\/p>\",\"duration\":1,\"order\":9,\"title\":\"Day 9: Victoria Falls\",\"locations\":[{\"latitude\":-18.730573,\"city_name\":\"Chobe National Park\",\"longitude\":24.429232,\"location_id\":9576,\"country_code\":\"BW\"},{\"latitude\":-17.931524,\"city_name\":\"Victoria Falls\",\"longitude\":25.827297,\"location_id\":9047,\"country_code\":\"ZW\"}]}],\"services\":{\"included\":{\"guide\":[{\"description\":\"<p>You will be accompanied by 3 crew members - Group Leader, Cook and Driver.<br><br>Your Group Leader\\u2019s role involves organizing the overall operation and smooth-running of the trip, managing trip logistics, coordinating the tipping kitty (where applicable) and will form work groups to take turns cooking, cleaning and shopping (from time to time your leader may drive as well).<br><br>Your Group Leader will work towards making the trip as safe and enjoyable as possible for all travellers. Intrepid trips are built around the co\\u2013operation and participation of all the group members under the supervision of the group leader. The group leader will show the group how to set up and use the equipment.<br><br>While not being guides in the traditional sense you can expect them to have a broad general knowledge of the countries visited on the trip, including historical, cultural, religious and social aspects. We also use local guides where we think more specific knowledge will add to the enjoyment of the places we are visiting, especially when tracking and identifying game - we think it's the best of both worlds. Regardless of the country of origin, our Group Leaders are chosen for their leadership skills and are wonderful ambassadors for our company and our beautiful continent and its people.<br><br>Your Cook is responsible for the cooking and will help to coordinate the work groups for preparing the meals and washing up! Cooks are also responsible for organising food shopping (they are always happy to have you on board) and most importantly, they make sure high hygiene standards are kept at all times while camping.<br><br>Your Driver\\u2019s main responsibility is to get you to your destination safely; they are also responsible for the maintenance of the vehicles along the way.<br><br>Everyone is expected participate and carry their share of the workload\\/duties, making camp chores easier. The duties rota system is adopted where all members share in general camp duties \\u2013 cooking, shopping, washing up etc. If the whole group participates it will be quicker, easier, and more fun.<br><br>We endeavour to provide the services of an experienced leader and crew; however, situations may arise where your leader is new to a particular region or training other group leaders.<\\/p>\",\"is_included\":true}],\"meals\":[{\"description\":\"<p>8 breakfasts, 3 lunches, 7 dinners<\\/p>\",\"is_included\":true,\"food_options\":[\"vegetarian\",\"vegan\",\"halal\",\"kosher\",\"meat\"]}],\"others\":[{\"description\":\"<p><p>Khama Rhino Sanctuary -  Entrance<\\/p><p>Khama Rhino Sanctuary - Sunset Game Drive Open Vehicle<\\/p><p>Okavango Delta - Mokoro Safari<\\/p><p>Gweta - Sundowner Bush Walk<\\/p><p>Victoria Falls Town - Leader-led orientation walk<\\/p><p>Chobe National Park - Open Safari Vehicle Morning Game Drive<\\/p><\\/p>\",\"is_included\":true}],\"transport\":[{\"description\":\"<p>Our trucks are purpose-built, self contained safari vehicles. Our fleet of vehicles varies depending on your group size, trip route and style. In Southern Africa some departures may use vans and luggage trailers subject to group size and vehicle availability. It is also important to note that our overland vehicles are not air-conditioned, but all vehicles have windows that can be opened to allow for fresh air. <br><br>There are many early starts with long hours spent driving on rough roads on all African itineraries. While most people love the chance to watch the changing landscape and daily village life, feedback shows that long periods of inactivity does not appeal to all clients. We provide the approximate distance covered each day and how many hours this normally takes to drive so that you can choose the safari experience that is right for you.<br><br>African conditions are extremely tough on vehicles. While we fastidiously maintain our vehicles at our workshops, you should not expect Africa to be your traditional touring experience. While it's certainly our aim to avoid them, it's important that you set off on your trip knowing that the occasional breakdown can happen and are best treated as part of the African adventure.  Due to wet weather there may be times when we have to take an alternative route which will mean longer travel times.<\\/p><p>Overland vehicle, 4WD safari vehicle, Mokoro<\\/p>\",\"is_included\":true,\"ships\":[]}],\"accommodation\":[{\"description\":\"<p>Accommodation on this trip is mainly in two-person canvas dome tents with camping mattresses supplied.<br><br>The type and variety of accommodation are determined by conditions on each of our routes. Each route is different - on some, we use a mixture of campsites and wild camps; on others, we also use hotels. In Africa, it's not usually practical to camp when staying in towns and cities, so we use hotel accommodations and eat out in local restaurants.<br><br>There may be the occasional night stop when we stay on the grounds of a hotel or at a campsite, which may also have rooms\\/cabins available. In this case, there may be a choice of camping or upgrading to a room. Rooms cost approximately<br><b> USD :<\\/b><br>40-100 per room per night for a twin room and cannot be pre-booked. Standards of these rooms vary greatly, and we recommend viewing the room before purchasing the night's accommodation. The day-by-day itinerary advises when upgrades may be possible (subject to availability).<br><br>Keep in mind that if we are staying in dormitory accommodation, you may have to share with other passengers or be split into same-sex rooms.<br><br>Campsites do have facilities, but they usually aren't to the same standard you would find in Western countries. For example, the bathroom facilities can be very basic. Toilet paper is rarely provided, and shower facilities can be as simple as a hose pipe spurting out cold water. Wild camps have no facilities at all.<br><br>At times, there may be spare tents in the vehicles. Unfortunately, these cannot be used without the purchase of a single supplement. This is to ensure the tents avoid wear and tear or are clean and ready for the customers arriving on the next section of the trip.<\\/p><p><p>Camping (with facilities) (5 nights), Camping (with basic facilities) (2 nights), Hotel (1 night)<\\/p><\\/p>\",\"is_included\":true,\"accommodations\":[{\"type\":\"camping\",\"nights\":7},{\"type\":\"hotel\",\"nights\":1}],\"ship_rooms\":[]}]},\"excluded\":{\"others\":[{\"description\":\"<p>Other activities and services not included.\\u00a0<\\/p>\",\"is_included\":false}],\"flights\":[{\"description\":\"<p>International flights are not included.\\u00a0<\\/p>\",\"is_included\":false}],\"optional\":[{\"description\":\"<p>Okavango Delta - Helicopter Scenic Flight - From USD250 - USD280<\\/p><p>Okavango Delta - Cook-led Cooking Class - Free<\\/p><p>Mukolo Camp - Sunset Cruise (excluding park fees) - NAD700<\\/p><p>Chobe National Park - River Cruise - BWP580<\\/p><p>Victoria Falls - Whitewater rafting (Seasonal - excludes USD10 NP Fee) - USD126<\\/p><p>Victoria Falls - Jet Boat (Seasonal - excludes USD10 NP Fee) - USD110<\\/p><p>Victoria Falls - Traditional Village Tour - USD55<\\/p><p>Victoria Falls - Bridge Tour - USD68<\\/p><p>Victoria Falls - Flying Fox \\/ Bridge Slide \\/ Zipline - USD48<\\/p><p>Victoria Falls - Bridge Swing - USD168<\\/p><p>Victoria Falls - Helicopter flight (12 mins - excludes USD25 Fuel & NP Fee) - USD150<\\/p><p>Victoria Falls - Helicopter flight (25 mins - excludes USD30 Fuel & NP Fee) - USD284<\\/p><p>Victoria Falls - Standard Sunset Cruise (excludes USD10 NP Fee) - USD45<\\/p><p>Victoria Falls - River Song Sunset Cruise (excludes USD10 NP Fee) - USD75<\\/p>\",\"is_included\":false}],\"insurance\":[{\"description\":\"Insurance is not included. Travel insurance is required for this tour. Please make sure you are adequately covered. If you require travel insurance, TourRadar has partnered up with Cover Genius to provide a hassle-free experience. More information can be found here (https:\\/\\/www.tourradar.com\\/travel-insurance).\",\"is_included\":false}]}},\"operator\":{\"id\":204,\"name\":\"Intrepid Travel\"},\"tourId\":92945,\"tourName\":\"Essential Botswana (from Johannesburg to Victoria Falls)\",\"reviewsCount\":13,\"tourLengthDays\":9,\"maxGroupSize\":22,\"guidingMethod\":\"Fully Guided\",\"tourType\":{\"4\":{\"type_id\":372,\"type_name\":\"Group\",\"group_id\":1,\"group_name\":\"Group Type\"}},\"tourTypes\":[{\"type_id\":4,\"type_name\":\"Overland Truck\",\"group_id\":11,\"group_name\":\"Adventure Styles\"},{\"type_id\":24,\"type_name\":\"Wildlife\",\"group_id\":21,\"group_name\":\"Safari Styles\"},{\"type_id\":173,\"type_name\":\"Camping\",\"group_id\":12,\"group_name\":\"Adventure Activities\"},{\"type_id\":354,\"type_name\":\"Elephant\",\"group_id\":21,\"group_name\":\"Safari Styles\"},{\"type_id\":372,\"type_name\":\"Group\",\"group_id\":1,\"group_name\":\"Group Type\"},{\"type_id\":373,\"type_name\":\"Fully Guided\",\"group_id\":2,\"group_name\":\"Guide Type\"},{\"type_id\":377,\"type_name\":\"Easy\",\"group_id\":3,\"group_name\":\"Physical r